{
  "$defs": {
    "BoardReply": {
      "additionalProperties": false,
      "properties": {
        "tools": {
          "items": {
            "discriminator": {
              "mapping": {
                "clear": "#/$defs/Clear",
                "diagram": "#/$defs/Diagram",
                "formula": "#/$defs/Formula",
                "note": "#/$defs/Note",
                "quiz": "#/$defs/Quiz"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Note"
              },
              {
                "$ref": "#/$defs/Formula"
              },
              {
                "$ref": "#/$defs/Diagram"
              },
              {
                "$ref": "#/$defs/Quiz"
              },
              {
                "$ref": "#/$defs/Clear"
              }
            ]
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "tools"
      ],
      "title": "BoardReply",
      "type": "object"
    },
    "CallCreated": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "title": "Conversation Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "settings": {
          "$ref": "#/$defs/CallSettings"
        },
        "teaching_available": {
          "default": true,
          "title": "Teaching Available",
          "type": "boolean"
        },
        "token": {
          "maxLength": 128,
          "minLength": 32,
          "title": "Token",
          "type": "string"
        }
      },
      "required": [
        "conversation_id",
        "token",
        "settings"
      ],
      "title": "CallCreated",
      "type": "object"
    },
    "CallSettings": {
      "additionalProperties": false,
      "properties": {
        "avatar": {
          "default": "einstein",
          "enum": [
            "einstein",
            "einstein-portrait",
            "mira-photo",
            "mira",
            "portrait",
            "orbit",
            "lumen"
          ],
          "title": "Avatar",
          "type": "string"
        },
        "model": {
          "default": "qwen2.5:1.5b",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Model",
          "type": "string"
        },
        "provider_id": {
          "default": "local",
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "title": "Provider Id",
          "type": "string"
        },
        "voice": {
          "default": "am_michael",
          "enum": [
            "af_heart",
            "af_bella",
            "am_michael",
            "bf_emma"
          ],
          "title": "Voice",
          "type": "string"
        }
      },
      "title": "CallSettings",
      "type": "object"
    },
    "Clear": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "clear",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Clear",
      "type": "object"
    },
    "Diagram": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "diagram",
          "title": "Kind",
          "type": "string"
        },
        "mermaid": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Mermaid",
          "type": "string"
        },
        "title": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "title",
        "mermaid"
      ],
      "title": "Diagram",
      "type": "object"
    },
    "Formula": {
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "maxLength": 1000,
          "title": "Explanation",
          "type": "string"
        },
        "kind": {
          "const": "formula",
          "title": "Kind",
          "type": "string"
        },
        "latex": {
          "description": "Standard LaTeX; prefer plain F=ma for simple formulas.",
          "maxLength": 600,
          "minLength": 1,
          "title": "Latex",
          "type": "string"
        },
        "title": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "title",
        "latex",
        "explanation"
      ],
      "title": "Formula",
      "type": "object"
    },
    "Hello": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "title": "Conversation Id",
          "type": "string"
        },
        "token": {
          "maxLength": 128,
          "minLength": 32,
          "title": "Token",
          "type": "string"
        },
        "type": {
          "const": "hello",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "conversation_id",
        "token"
      ],
      "title": "Hello",
      "type": "object"
    },
    "Note": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "note",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 1500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "title": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "title",
        "text"
      ],
      "title": "Note",
      "type": "object"
    },
    "Offer": {
      "additionalProperties": false,
      "properties": {
        "sdp": {
          "maxLength": 65536,
          "minLength": 1,
          "title": "Sdp",
          "type": "string"
        },
        "type": {
          "const": "offer",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "sdp",
        "type"
      ],
      "title": "Offer",
      "type": "object"
    },
    "ProviderConfiguration": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "compatible",
          "enum": [
            "compatible",
            "openrouter"
          ],
          "title": "Kind",
          "type": "string"
        },
        "max_output_tokens": {
          "default": 700,
          "maximum": 1024,
          "minimum": 64,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "model": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:/-]+$",
          "title": "Model",
          "type": "string"
        },
        "model_identity": {
          "const": "provider_declared",
          "default": "provider_declared",
          "title": "Model Identity",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "requires_key": {
          "default": false,
          "title": "Requires Key",
          "type": "boolean"
        },
        "teaching": {
          "default": false,
          "title": "Teaching",
          "type": "boolean"
        },
        "terms_url": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terms Url"
        },
        "timeout_seconds": {
          "default": 60,
          "maximum": 90,
          "minimum": 5,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "endpoint",
        "model"
      ],
      "title": "ProviderConfiguration",
      "type": "object"
    },
    "ProviderList": {
      "additionalProperties": false,
      "properties": {
        "providers": {
          "items": {
            "$ref": "#/$defs/ProviderView"
          },
          "title": "Providers",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "providers"
      ],
      "title": "ProviderList",
      "type": "object"
    },
    "ProviderView": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "$ref": "#/$defs/ProviderConfiguration"
        },
        "credential_configured": {
          "title": "Credential Configured",
          "type": "boolean"
        },
        "evidence": {
          "const": "experimental",
          "default": "experimental",
          "title": "Evidence",
          "type": "string"
        },
        "ready": {
          "title": "Ready",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "configuration",
        "credential_configured",
        "ready",
        "reason"
      ],
      "title": "ProviderView",
      "type": "object"
    },
    "ProviderWrite": {
      "additionalProperties": false,
      "properties": {
        "api_key": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key"
        },
        "configuration": {
          "$ref": "#/$defs/ProviderConfiguration"
        },
        "remove_key": {
          "default": false,
          "title": "Remove Key",
          "type": "boolean"
        }
      },
      "required": [
        "configuration"
      ],
      "title": "ProviderWrite",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "properties": {
        "teach": {
          "default": false,
          "title": "Teach",
          "type": "boolean"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "ask",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "title": "Question",
      "type": "object"
    },
    "Quiz": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "description": "Copy the exact correct choice text, never a letter or index.",
          "maxLength": 200,
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        },
        "choices": {
          "description": "Plain choices without A/B labels. Exactly one correct; others must be false, not equivalent rearrangements.",
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Choices",
          "type": "array"
        },
        "explanation": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "kind": {
          "const": "quiz",
          "title": "Kind",
          "type": "string"
        },
        "question": {
          "description": "A short learner-facing question, never a copied request.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "question",
        "choices",
        "answer",
        "explanation"
      ],
      "title": "Quiz",
      "type": "object"
    },
    "TeachMode": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "type": {
          "const": "teach_mode",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "enabled"
      ],
      "title": "TeachMode",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "board": {
      "$ref": "#/$defs/BoardReply"
    },
    "created": {
      "$ref": "#/$defs/CallCreated"
    },
    "hello": {
      "$ref": "#/$defs/Hello"
    },
    "offer": {
      "$ref": "#/$defs/Offer"
    },
    "provider_write": {
      "$ref": "#/$defs/ProviderWrite"
    },
    "providers": {
      "$ref": "#/$defs/ProviderList"
    },
    "question": {
      "$ref": "#/$defs/Question"
    },
    "settings": {
      "$ref": "#/$defs/CallSettings"
    },
    "teach_mode": {
      "$ref": "#/$defs/TeachMode"
    }
  },
  "required": [
    "settings",
    "created",
    "hello",
    "offer",
    "question",
    "teach_mode",
    "board",
    "providers",
    "provider_write"
  ],
  "title": "ControlContract",
  "type": "object"
}
